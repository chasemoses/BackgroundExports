{
  "ConnectionStrings": {
    "Exports": "Server=(localdb)\\MSSQLLocalDB;Database=BackgroundExportsDemo;Integrated Security=true;TrustServerCertificate=true"
  },
  "Exports": {
    "Workers": 2,
